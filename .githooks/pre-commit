#!/usr/bin/env bash
set -euo pipefail

HOOK_DIR=$(dirname "$(readlink -f "$0")")
REPO_ROOT=$(git rev-parse --show-toplevel)

# 1) rustfmt check. A repo whose rustfmt.toml sets nightly-only options needs
# `cargo +nightly fmt` — stable rustfmt silently ignores such options instead
# of erroring, so detect the need from the file rather than hardcoding per repo.
if [[ -f "$REPO_ROOT/rustfmt.toml" ]]; then
    FMT_TOOLCHAIN="+nightly"
else
    FMT_TOOLCHAIN=""
fi

if ! cargo $FMT_TOOLCHAIN fmt --all -- --check; then
    cat >&2 <<MSG

✖ rustfmt check failed.
  Run:  cargo $FMT_TOOLCHAIN fmt --all
  Then re-stage and re-commit.
MSG
    if [[ -n "$FMT_TOOLCHAIN" ]]; then
        cat >&2 <<MSG
  (Plain "cargo fmt" is not enough — this repo's rustfmt.toml uses
  nightly-only options that stable rustfmt silently ignores.)
MSG
    fi
    echo >&2
    exit 1
fi

# 2) Internal-reference check on staged code.
"$HOOK_DIR/check-no-dd-refs.sh" --staged
