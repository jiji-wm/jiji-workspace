# Nested git repos (cloned via scripts/clone.sh)
/repos/

# Claude Code personal / runtime state (shared agent + command definitions are tracked)
/.claude/settings.local.json
/.claude/scheduled_tasks.lock

# Claude Code runbook staging area (not part of the tracked setup)
/docs/claude/

# Temp files / playgrounds
/tmp/

# Specs overlay (DDs, specs, plans, status) — its own access-restricted repo
/specs/

# Agent worktrees (runtime state)
/.claude/worktrees/

# Brainstorming visual-companion artifacts (mockups, server state)
/.superpowers/

# Personal scratch todo list (feature ideas live in the specs overlay / tool DDs)
/TODO.md

# Overlay-coupled Claude command (canonical copy lives in the specs overlay)
/.claude/commands/jiji/initiative.md

# Session-notes directory (self-ignoring, but do not rely on that)
/.remember/
